# Copy this to .env and fill in values. .env is gitignored.

# AWS
AWS_PROFILE=ghtrends
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=

# Project naming
PROJECT_NAME=ghtrends
ENV=dev

# Terraform state backend (created in Phase 1 by bootstrap script)
TFSTATE_BUCKET=
TFSTATE_LOCK_TABLE=tfstate-locks

# GitHub PAT for repo metadata enrichment in Phase 5
# Generate at https://github.com/settings/tokens — needs no scopes (public read only)
GITHUB_PAT=

# S3 location of the numpy vector index built in Phase 5
EMBEDDINGS_BUCKET=ghtrends-dev-lake

# Athena query result location
ATHENA_OUTPUT_S3=s3://ghtrends-dev-lake/athena_results/

# Streamlit
STREAMLIT_PORT=8501
